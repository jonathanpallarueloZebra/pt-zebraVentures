      "active": true,
      "scope_records": [],
      "customizable": false
    }
  },
  {
    "model": "restrictions.restriction",
    "pk": 73,
    "fields": {
      "name": "Mínimo 1 persona de Caja por turno",
      "description": "[CABRERO] Cada turno abierto necesita al menos una persona de caja.",
