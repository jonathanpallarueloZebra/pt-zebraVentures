[
  {
    "model": "restrictions.restriction",
    "pk": 68,
    "fields": {
      "name": "Máximo 1 turno por día por trabajador",
      "description": "[CABRERO] Un trabajador no puede tener más de un turno asignado el mismo día.",
      "engine": "count",
      "config": {
        "groupBy": "day_worker",
        "subject": "shifts",
        "operator": "lte",
        "threshold": 1
      },
      "severity": "error",
      "message": "{worker}: {count} turnos el mismo día (máx {limit})",
      "active": true,
      "scope_records": [],
      "customizable": false
    }
  },
  {
    "model": "restrictions.restriction",
    "pk": 69,
    "fields": {
      "name": "Elegibilidad por tienda y zona (plantilla / COMÚN / ETT)",
      "description": "[CABRERO] Un trabajador de plantilla solo puede planificarse en su tienda. El personal COMÚN y ETT puede planificarse en cualquier tienda de su misma zona de movilidad.",
      "engine": "condition",
      "config": {
        "scopeMatch": {
          "rules": [
            {
              "matchType": "id",
              "workerField": "tienda"
            },
            {
              "gapField": "secciones",
              "matchType": "field",
              "scopeField": "zona",
              "workerField": "zona",
              "requireField": "tipo_contrato",
              "requireValue": "comun"
            },
            {
              "gapField": "secciones",
              "matchType": "field",
              "scopeField": "zona",
              "workerField": "zona",
              "requireField": "tipo_contrato",
              "requireValue": "ett"
            }
          ]
        }
      },
      "severity": "error",
      "message": "{worker} no puede trabajar en esta tienda (fuera de su ámbito)",
      "active": true,
      "scope_records": [],
      "customizable": false
    }
  },
  {
    "model": "restrictions.restriction",
    "pk": 70,
    "fields": {
      "name": "Máximo 2 trabajadores ETT por turno",
      "description": "[CABRERO] No concentrar más de 2 trabajadores de ETT en el mismo turno.",
      "engine": "count",
      "config": {
        "groupBy": "shift",
        "subject": "workers",
        "operator": "lte",
        "threshold": 2,
        "filterField": "tipo_contrato",
        "filterValue": "ett"
      },
      "severity": "warning",
      "message": "{shift}: {count} trabajadores ETT (máx {limit})",
      "active": true,
      "scope_records": [],
      "customizable": false
    }
  },
  {
    "model": "restrictions.restriction",
    "pk": 71,
    "fields": {
      "name": "Régimen antiguo no trabaja sábado tarde",
      "description": "[CABRERO] El régimen antiguo (Antigüedad = vacío) no incluye el sábado por la tarde en su jornada ordinaria; si trabaja ese turno, cuenta como hora extra y no debe asignarse por defecto.",
      "engine": "condition",
      "config": {
        "scope": "per_week_worker_shift",
        "filter": {
          "op": "eq",
          "field": "regimen",
          "value": "antiguo"
        },
        "operator": "lte",
        "threshold": 0,
        "targetShift": "156"
      },
      "severity": "error",
      "message": "{worker} (régimen antiguo) asignada a sábado tarde: sería HORA EXTRA",
      "active": true,
      "scope_records": [],
      "customizable": false
    }
  },
  {
    "model": "restrictions.restriction",
    "pk": 72,
    "fields": {
      "name": "Máximo 1 encargado por turno",
      "description": "[CABRERO] No debería haber más de un encargado en el mismo turno de la misma tienda.",
      "engine": "count",
      "config": {
        "groupBy": "shift_area",
        "subject": "workers",
