# Traefik (o el balanceador de delante) termina el TLS y nos entrega la peticion
# por HTTP en el puerto 80, asi que $scheme vale "http" aunque el usuario navegue
# por https. Pasar `X-Forwarded-Proto $scheme` a secas PISA el valor real que
# manda el proxy, Django deja de ver la peticion como segura y
# request.build_absolute_uri() genera URLs http://. El navegador entonces bloquea
# el favicon de branding por mixed content en una pagina https (el logo, al ser un
# <img>, sigue el redirect y colaba sin avisar).
#
# Este map respeta lo que llegue de delante y solo cae a $scheme si no viene nada
# (acceso directo al contenedor, sin proxy). Va fuera del server porque `map` es
# una directiva de nivel http, y conf.d/*.conf se incluye dentro de http {}.
map $http_x_forwarded_proto $zb_forwarded_proto {
    ''      $scheme;
    default $http_x_forwarded_proto;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Tamaño máximo de subida (imágenes de branding, excel, etc.)
    client_max_body_size 25m;

    # Proxy de la API hacia el backend. El host se inyecta por la variable de
    # entorno BACKEND_HOST al arrancar el contenedor (nginx sustituye plantillas
    # en /etc/nginx/templates/). Se conserva el prefijo /api/ porque Django
    # enruta todo bajo /api/.
    location ^~ /api/ {
        proxy_pass http://${BACKEND_HOST}:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $zb_forwarded_proto;
        proxy_read_timeout 300s;
    }

    # /media/ es ambiguo: lo usan tanto las fuentes que Angular empaqueta
    # en dist/browser/media/ como los uploads de Django (MEDIA_URL=/media/).
    # Primero se intenta servir el archivo local (fuentes); si no existe,
    # se hace proxy al backend (uploads de branding).
    location ^~ /media/ {
        try_files $uri @backend;
    }

    location @backend {
        proxy_pass http://${BACKEND_HOST}:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $zb_forwarded_proto;
    }

    # Assets con nombre hasheado (outputHashing: "all" en angular.json): su
    # contenido no cambia nunca sin cambiar el nombre, asi que se cachean a un
    # ano. El `=404` es deliberado: sin el, un chunk que falta cae en el
    # try_files de `location /` y nginx devuelve index.html con 200 y
    # Content-Type: text/html. El navegador intenta evaluar ~100 KB de HTML
    # como modulo JS y lanza un "Failed to fetch dynamically imported module"
    # que no dice nada. Con un 404 limpio el fallo es evidente en el Network.
    # Los location ^~ de /api/ y /media/ tienen prioridad sobre este regex.
    location ~* \.(?:js|mjs|css|map|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$ {
        expires 1y;
        # SIN `always` a proposito: con el, nginx pega esta cabecera tambien a
        # las respuestas de error, y un 404 transitorio de un chunk (proxy sin
        # ruta durante un redespliegue, contenedor reiniciandose) se quedaria
        # cacheado un ano en el navegador del usuario. `expires` y `add_header`
        # sin `always` solo aplican a 2xx/3xx, que es lo que queremos.
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html NUNCA se cachea. Es la unica pieza sin hash en el nombre y la
    # que referencia los chunks hasheados. Sin Cache-Control el navegador le
    # aplica cache heuristica (una fraccion del tiempo desde Last-Modified) y
    # puede seguir usando el index.html de un despliegue anterior, pidiendo
    # chunks que ya no existen: 404 en todas las rutas lazy tras cada deploy.
    # `no-cache` no impide el cacheo, obliga a revalidar (304 si no cambio).
    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    # SPA de Angular: cualquier otra ruta cae en index.html.
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
