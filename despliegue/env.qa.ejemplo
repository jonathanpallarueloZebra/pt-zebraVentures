# Entorno de QA — copiar a `.env.qa` EN EL SERVIDOR y rellenar.
#
#   cp despliegue/env.qa.ejemplo .env.qa
#
# El fichero `.env.qa` NO va al repositorio (está en .gitignore).

# ── Versión desplegada ─────────────────────────────────────────────────
# Tag de las imágenes, en el formato de ADEA: X.Y.Z-qa (el sufijo tiene que
# coincidir con el entorno; desplegar.sh lo comprueba y aborta si no).
# Lo reescribe desplegar.sh en cada despliegue, no hace falta tocarlo a mano.
VERSION=0.1.0-qa

# ── Django ─────────────────────────────────────────────────────────────
ENVIRONMENT=qa
DEBUG=False
# Generar una nueva, distinta de la de producción:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# ── Base de datos de QA ────────────────────────────────────────────────
# SEPARADA de la de producción. Comprobar dos veces que no es la de prod.
DB_NAME=ptzebra_qa
DB_USER=ptzebra_qa
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# ── Dominio ────────────────────────────────────────────────────────────
# settings.py añade siempre '.zebraventures.eu', 'localhost' y '127.0.0.1',
# así que aquí solo hacen falta los hosts internos.
ALLOWED_HOSTS=ptzebra-backend-qa,localhost,127.0.0.1
FRONTEND_URL=https://ptzebra-qa.zebraventures.eu

# ── Agente de chat ─────────────────────────────────────────────────────
# Sin AGENT_MODEL el agente responde 503 y el chat queda inoperativo
# (el resto de la API funciona igual).
AGENT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
AGENT_PERSONALITY=

# ── Registry ───────────────────────────────────────────────────────────
# Descomentar solo si se publica en otro sitio del que trae el compose.
# REGISTRO=ghcr.io/zebra-ventures/ptzebra
