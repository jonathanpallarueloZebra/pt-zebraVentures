# Entorno de PRODUCCIÓN — copiar a `.env.prod` EN EL SERVIDOR y rellenar.
#
#   cp despliegue/env.prod.ejemplo .env.prod
#
# El fichero `.env.prod` NO va al repositorio (está en .gitignore).
#
# ⚠️ Antes de levantar, comprobar que DB_NAME NO es la base de QA.

# ── Versión desplegada ─────────────────────────────────────────────────
# Obligatoria: el compose de producción no acepta `latest`, para no depender
# de qué apuntaba ese tag el día del despliegue.
# Desplegar SOLO un tag ya probado en QA.
VERSION=

# ── Django ─────────────────────────────────────────────────────────────
ENVIRONMENT=prod
# DEBUG va fijado a False en el compose y no se puede sobreescribir desde aquí.
# Generar una nueva, DISTINTA de la de QA:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# ── Base de datos de PRODUCCIÓN ────────────────────────────────────────
# SEPARADA de la de QA. Usuario propio, sin permisos sobre la base de QA.
DB_NAME=ptzebra_prod
DB_USER=ptzebra_prod
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# ── Dominio ────────────────────────────────────────────────────────────
ALLOWED_HOSTS=ptzebra-backend-prod,localhost,127.0.0.1
FRONTEND_URL=https://ptzebra.zebraventures.eu

# ── Agente de chat ─────────────────────────────────────────────────────
AGENT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
AGENT_PERSONALITY=

# ── Registry ───────────────────────────────────────────────────────────
# REGISTRO=europe-southwest1-docker.pkg.dev/admin-zebra/ptzebra-apps
